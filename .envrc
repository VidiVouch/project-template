# direnv configuration (optional — install: https://direnv.net/).
#
# On WSL-on-Windows, a single .venv/ can't be shared with Windows PowerShell
# (WSL expects .venv/bin/python, PowerShell creates .venv/Scripts/python.exe).
# When the same checkout is accessed from both shells, point uv at a
# WSL-specific venv directory so the two don't fight.
#
# On native Linux/macOS and on Windows PowerShell this file is either a no-op
# (grep fails because /proc/version doesn't mention Microsoft) or ignored
# (PowerShell doesn't run direnv), so the default .venv/ is used.

if grep -qi -e microsoft -e wsl /proc/version 2>/dev/null; then
    export UV_PROJECT_ENVIRONMENT=.venv-wsl
fi
